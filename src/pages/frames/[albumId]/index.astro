---
import Layout from "../../../layouts/Layout.astro";
import { fetchExhibitManifest, getAlbumById } from "../../../lib/exhibit-data";
import type { ExhibitManifest } from "../../../types";

export async function getStaticPaths() {
    const manifest = await fetchExhibitManifest();
    return manifest.albums.map((album) => ({
        params: { albumId: album.id },
        props: { album },
    }));
}

const { album } = Astro.props;
const manifest = await fetchExhibitManifest();
const settings = manifest.exhibit_info?.settings;
const mobileLayout = settings?.mobile_layout || "scroll";
const desktopLayout = settings?.desktop_layout || "slideshow";

const showScrollOnMobile = mobileLayout === "scroll";
const showGridOnMobile = mobileLayout === "slideshow";

const scrollClasses = showScrollOnMobile
    ? "flex flex-col gap-12 items-center w-full max-w-3xl mx-auto py-8 md:hidden"
    : "hidden";

const gridClasses = showGridOnMobile
    ? "grid grid-cols-1 sm:grid-cols-2 w-full md:flex md:flex-col md:gap-12 md:items-center"
    : "hidden md:flex md:flex-col md:gap-12 md:items-center w-full";
---

<Layout title={`SILVER STILL: ${album.album_name}`}>
    <main class="container mx-auto px-4 py-8">
        <nav class="mb-8 flex items-center justify-between">
            <a
                href="/"
                class="text-neutral-500 hover:text-white transition-colors uppercase text-xs tracking-widest"
            >
                ← Return to Albums
            </a>
            <h1
                class="text-xl text-center text-white font-light tracking-widest uppercase"
            >
                {album.album_name}
            </h1>
            <div class="w-24"></div>
            <!-- Spacer for centering -->
        </nav>

        {showScrollOnMobile && (
            <div class={scrollClasses}>
                {album.photos.map((photo) => (
                    <a
                        href={`/frames/${album.id}/${photo.lightroom_id}`}
                        class="group block w-full"
                    >
                        <div class="relative overflow-hidden bg-neutral-950/20 shadow-2xl transition-transform duration-500 hover:scale-[1.01]">
                            <img
                                src={photo.cover_url}
                                alt={photo.metadata?.title || photo.title || "Untitled"}
                                class="w-full h-auto object-contain max-h-[70vh] mx-auto block opacity-95 group-hover:opacity-100 transition-opacity duration-300"
                                loading="lazy"
                            />
                            {photo.metadata?.status === "sold out" && (
                                <div 
                                    class="absolute top-4 left-4 z-10 px-2 py-0.5 text-[9px] font-bold tracking-widest uppercase border"
                                    style="color: var(--color-background); background-color: var(--color-accent); border-color: var(--color-accent);"
                                >
                                    Sold Out
                                </div>
                            )}
                        </div>
                    </a>
                ))}
            </div>
        )}

        <div class={gridClasses}>
            {
                album.photos.map((photo) => (
                    <a
                        href={`/frames/${album.id}/${photo.lightroom_id}`}
                        class="group block relative aspect-square bg-neutral-900 overflow-hidden md:aspect-auto md:bg-neutral-950/20 md:w-full md:max-w-2xl md:mx-auto md:shadow-2xl md:transition-transform md:duration-500 md:hover:scale-[1.01]"
                    >
                        <img
                            src={photo.cover_url}
                            alt={photo.metadata?.title || photo.title || "Untitled"}
                            class="w-full h-full object-cover transition-all duration-700 ease-in-out group-hover:scale-105 group-hover:opacity-100 opacity-90 md:h-auto md:object-contain md:max-h-[80vh] md:mx-auto md:block md:opacity-95 md:group-hover:opacity-100 md:group-hover:scale-100"
                            loading="lazy"
                        />
                        {photo.metadata?.status === "sold out" && (
                            <div 
                                class="absolute top-4 left-4 z-10 px-2 py-0.5 text-[9px] font-bold tracking-widest uppercase border"
                                style="color: var(--color-background); background-color: var(--color-accent); border-color: var(--color-accent);"
                            >
                                Sold Out
                            </div>
                        )}
                        <div class="absolute inset-x-0 bottom-0 p-4 bg-gradient-to-t from-black/80 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                            <p class="text-white text-sm font-light tracking-wide truncate">
                                {photo.metadata?.title || photo.title || "Untitled"}
                            </p>
                        </div>
                    </a>
                ))
            }
        </div>
    </main>
</Layout>
